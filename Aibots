import random
from datetime import datetime

print("Hello! I am your AI assistant.")
print("You can ask me things like:")
print("- What is your name?")
print("- Who made you?")
print("- What is the time?")
print("- Tell me a joke")
print("- Bye")

greetings = ["hello", "hi", "hey", "good morning", "good afternoon", "good evening"]
good_responses = [
    "I'm doing well, thanks for asking!",
    "All good here! How about you?",
    "Feeling great and ready to help!",
]

while True:
    user_input = input("You: ").lower()

    # Respond to greetings
    if any(greet in user_input for greet in greetings):
        print("AI: Hello there! How can I help you today?")

    elif "how are you" in user_input:
        print("AI:", random.choice(good_responses))

    elif "your name" in user_input or "what is your name" in user_input:
        print("AI: I don't have a name. I'm just a personal AI assistant of Kekhrieseto.")

    elif "who made you" in user_input or "created you" in user_input:
        print("AI: Kekhrieseto made me.")

    elif "time" in user_input:
        now = datetime.now()
        print("AI: The current time is", now.strftime("%H:%M:%S"))

    elif "joke" in user_input:
        jokes = [
            "Why don't scientists trust atoms? Because they make up everything!",
            "What do you call fake spaghetti? An impasta!",
            "I told my computer I needed a break, and it said 'No problem, I’ll go to sleep!'"
        ]
        print("AI:", random.choice(jokes))

    elif "bye" in user_input or "exit" in user_input:
        print("AI: Goodbye! Have a nice day.")
        break

    else:
        print("AI: I'm not sure how to answer that. Try asking something else.")
